# Ignore everything
*

# Allow only specific files
!Image_Classifier!.ipynb
!requirements.txt
!README.md
!LICENSE

# Ignore system files
.DS_Store
Thumbs.db

# Training pipeline added alongside the notebook
!scripts/
!scripts/*.py
!.gitignore

# ...but never the things it produces: a 5.7GB venv, the 113MB face cache and
# the saved models. Regenerate with prep.py then train.py.
venv_tf/
env_age_gender/
cache_faces*.npz
tuner/
UTKFace/
# the rendered grid is the deliverable, so it is kept; the models beside it are not.
# The deny-all `*` at the top means the directory itself has to be re-allowed first,
# or git never descends into it to see the negation below.
!artifacts/
artifacts/*
!artifacts/prediction-grid.png

# The shared package, its tests and the CI that gates them. The deny-all `*` at
# the top means each directory has to be re-allowed before git will descend into
# it, so the directory and its contents are both listed.
!agc/
!agc/*.py
!tests/
!tests/*.py
!.github/
!.github/workflows/
!.github/workflows/*.yml
!pyproject.toml
!requirements-dev.txt

# The SQL lives in real .sql files so the aggregations can be run against the
# database by hand, without going through Python.
!sql/
!sql/*.sql

# Container + API. The saved model is still ignored; the image expects it to be
# built by prep.py + train.py, or mounted in.
!Dockerfile
!docker-compose.yml
!requirements-serve.txt
